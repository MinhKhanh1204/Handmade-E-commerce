@model BussinessObject.Product
@using HandicraftShop_Prodject.Utils
@{
    ViewData["Title"] = "Product Detail Page";
    var currentUser = AccountUtils.GetUserData(User);
}

<!-- Page Title -->
<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">Product Details</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="/Home">Home</a></li>
                <li><a href="/Product">Products</a></li>
                <li class="current">@Model.ProductName</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- Product Details Section -->
<section id="product-details" class="product-details section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row">
            <!-- Product Images -->
            <div class="col-lg-6 mb-5 mb-lg-0" data-aos="fade-right" data-aos-delay="200">
                <div class="product-images">
                    <div class="main-image-container mb-3">
                        <div class="image-zoom-container">
                            <img src="/assets/img/product/@Model.ProductImages.First().ImageUrl" 
                                 alt="@Model.ProductName" 
                                 class="img-fluid main-image" 
                                 id="main-product-image">
                        </div>
                    </div>

                    <div class="product-thumbnails">
                        <div class="swiper product-thumbnails-slider init-swiper">
                            <div class="swiper-wrapper">
                                @foreach (var item in Model.ProductImages)
                                {
                                    <div class="swiper-slide thumbnail-item @(Model.ProductImages.First() == item ? "active" : "")" 
                                         data-image="/assets/img/product/@item.ImageUrl">
                                        <img src="/assets/img/product/@item.ImageUrl" alt="Thumbnail" class="img-fluid">
                                    </div>
                                }
                            </div>
                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="200">
                <div class="product-info">
                    <div class="product-meta mb-2">
                        <span class="product-category">@Model.Category.CategoryName</span>
                        @{
                            var avgRating = Model.Feedbacks.Any()
                                ? Math.Round(Model.Feedbacks.Average(f => f.Rating ?? 0), 1)
                                : 0;
                        }
                        <div class="product-rating">
                            @for (var i = 1; i <= 5; i++)
                            {
                                if (avgRating >= i)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else if (avgRating >= i - 0.5)
                                {
                                    <i class="bi bi-star-half text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning"></i>
                                }
                            }
                            <span class="rating-count">(@Model.Feedbacks.Count reviews)</span>
                        </div>
                    </div>

                    <h1 class="product-title">@Model.ProductName</h1>

                    <div class="product-price-container mb-4">
                        @{
                            var originalPrice = Model.Price ?? 0;
                            var discount = Model.Discount ?? 0;
                            var discountedPrice = originalPrice - (originalPrice * discount / 100);
                        }
                        @if (discount > 0)
                        {
                            <span class="current-price">@discountedPrice.ToString("N0") VNĐ</span>
                            <span class="original-price">@originalPrice.ToString("N0") VNĐ</span>
                            <span class="discount-badge">-@discount.ToString("N0")%</span>
                        }
                        else
                        {
                            <span class="current-price">@originalPrice.ToString("N0") VNĐ</span>
                        }
                    </div>

                    <div class="product-short-description mb-4">
                        <p>@Model.Description</p>
                    </div>

                    <div class="product-availability mb-4">
                        @if (Model.StockQuantity > 0)
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>In Stock</span>
                            <span class="stock-count">(@Model.StockQuantity items left)</span>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span>Out of Stock</span>
                        }
                    </div>

                    <!-- Quantity Selector -->
                    @if (Model.StockQuantity > 0)
                    {
                        <div class="product-quantity mb-4">
                            <h6 class="option-title">Quantity:</h6>
                            <div class="quantity-selector">
                                <button class="quantity-btn decrease" type="button">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input type="number" class="quantity-input" value="1" min="1" max="@Model.StockQuantity">
                                <button class="quantity-btn increase" type="button">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="product-actions">
                        @if (Model.StockQuantity > 0)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="quantity" class="quantity-value" value="1" />
                                <button type="submit" class="btn btn-primary add-to-cart-btn">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-primary" disabled>
                                <i class="bi bi-cart-x"></i> Out of Stock
                            </button>
                        }
                        <button class="btn btn-outline-secondary wishlist-btn">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>

                    <!-- Additional Info -->
                    <div class="additional-info mt-4">
                        <div class="info-item">
                            <i class="bi bi-truck"></i>
                            <span>Free shipping on orders over 500,000 VNĐ</span>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>30-day return policy</span>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-shield-check"></i>
                            <span>1-year warranty</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Details Tabs -->
        <div class="row mt-5" data-aos="fade-up">
            <div class="col-12">
                <div class="product-details-tabs">
                    <ul class="nav nav-tabs" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="description-tab" data-bs-toggle="tab" 
                                    data-bs-target="#description" type="button">
                                Description
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" 
                                    data-bs-target="#reviews" type="button">
                                Reviews (@Model.Feedbacks.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="productTabsContent">
                        <!-- Description Tab -->
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <div class="product-description">
                                <h4>Product Overview</h4>
                                <p>@Model.Description</p>
                                
                                @if (!string.IsNullOrEmpty(Model.Material))
                                {
                                    <h5 class="mt-4">Material</h5>
                                    <p>@Model.Material</p>
                                }
                            </div>
                        </div>

                        <!-- Reviews Tab -->
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <div class="product-reviews">
                                <!-- Reviews Summary -->
                                <div class="reviews-summary">
                                    <div class="overall-rating">
                                        <div class="rating-number">@avgRating</div>
                                        <div class="rating-stars">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                if (avgRating >= i)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else if (avgRating >= i - 0.5)
                                                {
                                                    <i class="bi bi-star-half text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                        </div>
                                        <div class="rating-count">Based on @Model.Feedbacks.Count reviews</div>
                                    </div>

                                    @{
                                        var feedbacks = Model.Feedbacks;
                                        var totalFeedback = feedbacks.Count();
                                        var ratingCounts = Enumerable.Range(1, 5)
                                            .Select(r => new
                                            {
                                                Star = r,
                                                Count = feedbacks.Count(f => f.Rating == r)
                                            })
                                            .OrderByDescending(r => r.Star)
                                            .ToList();
                                    }

                                    <div class="rating-breakdown">
                                        @foreach (var r in ratingCounts)
                                        {
                                            var percentage = totalFeedback > 0 ? (r.Count * 100.0 / totalFeedback) : 0;
                                            <div class="rating-bar">
                                                <div class="rating-label">@r.Star ⭐</div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                                </div>
                                                <div class="rating-count">@r.Count</div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Write Review Form (Only for logged in users who purchased) -->
                                @if (currentUser != null)
                                {
                                    var userFeedback = Model.Feedbacks.FirstOrDefault(f => f.CustomerId == currentUser.AccountId);
                                    
                                    @if (userFeedback == null)
                                    {
                                        <div class="review-form-container mt-5">
                                            <h4>Write a Review</h4>
                                            <p class="text-muted">Share your experience with this product</p>
                                            
                                            <form asp-controller="Feedback" asp-action="Add" method="post" class="review-form">
                                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                                
                                                <div class="mb-3">
                                                    <label class="form-label">Your Rating *</label>
                                                    <div class="star-rating-input">
                                                        @for (int i = 5; i >= 1; i--)
                                                        {
                                                            <input type="radio" id="star@(i)" name="rating" value="@i" required />
                                                            <label for="star@(i)" title="@i stars">
                                                                <i class="bi bi-star-fill"></i>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="comment" class="form-label">Your Review *</label>
                                                    <textarea class="form-control" id="comment" name="comment" 
                                                              rows="4" required 
                                                              placeholder="Tell others what you think about this product..."></textarea>
                                                </div>

                                                <button type="submit" class="btn btn-primary">
                                                    <i class="bi bi-send-fill"></i> Submit Review
                                                </button>
                                            </form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info mt-4">
                                        <i class="bi bi-info-circle me-2"></i>
                                        Please <a asp-controller="Auth" asp-action="Login" class="alert-link">login</a> to write a review.
                                    </div>
                                }

                                <!-- Reviews List -->
                                <div class="reviews-list mt-5">
                                    <h4>Customer Reviews</h4>

                                    @if (Model.Feedbacks.Any())
                                    {
                                        @foreach (var feedback in Model.Feedbacks.OrderByDescending(f => f.CreatedAt))
                                        {
                                            <div class="review-item">
                                                <div class="review-header">
                                                    <div class="reviewer-info">
                                                        <img src="/assets/img/person/@(feedback.Customer?.CustomerNavigation?.Avatar ?? "default-avatar.jpg")" 
                                                             alt="Avatar" 
                                                             class="reviewer-avatar">
                                                        <div>
                                                            <h5 class="reviewer-name">@(feedback.Customer?.CustomerNavigation?.Username ?? "Anonymous")</h5>
                                                            <div class="review-date">@feedback.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                                        </div>
                                                    </div>
                                                    <div class="review-rating">
                                                        @for (var i = 1; i <= 5; i++)
                                                        {
                                                            if (feedback.Rating >= i)
                                                            {
                                                                <i class="bi bi-star-fill text-warning"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-star text-warning"></i>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                
                                                <div class="review-content">
                                                    <p>@feedback.Comment</p>
                                                </div>

                                                @if (feedback.FeedbackImages.Any())
                                                {
                                                    <div class="review-images">
                                                        @foreach (var img in feedback.FeedbackImages)
                                                        {
                                                            <img src="/assets/img/feedback/@img.ImageUrl" alt="Review Image" class="img-thumbnail">
                                                        }
                                                    </div>
                                                }

                                                @* Show Edit/Delete if this is user's feedback *@
                                                @if (currentUser != null && feedback.CustomerId == currentUser.AccountId)
                                                {
                                                    <div class="review-actions mt-3">
                                                        <button class="btn btn-sm btn-outline-primary" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#editModal@(feedback.FeedbackId)">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </button>
                                                        
                                                        <form asp-controller="Feedback" asp-action="Delete" method="post" 
                                                              class="d-inline" 
                                                              onsubmit="return confirm('Are you sure you want to delete this review?');">
                                                            <input type="hidden" name="feedbackId" value="@feedback.FeedbackId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i> Delete
                                                            </button>
                                                        </form>
                                                    </div>

                                                    @* Edit Modal *@
<div class="modal fade" id="editModal@(feedback.FeedbackId)" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Feedback" asp-action="Edit" method="post">
                <input type="hidden" name="feedbackId" value="@feedback.FeedbackId" />
                
                <div class="modal-header">
                    <h5 class="modal-title">Edit Your Review</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Your Rating</label>
                        <select name="rating" class="form-select" required>
                            @{
                                var ratings = new[] 
                                { 
                                    new { Value = 5, Label = "⭐⭐⭐⭐⭐ Excellent" },
                                    new { Value = 4, Label = "⭐⭐⭐⭐ Good" },
                                    new { Value = 3, Label = "⭐⭐⭐ Average" },
                                    new { Value = 2, Label = "⭐⭐ Poor" },
                                    new { Value = 1, Label = "⭐ Terrible" }
                                };
                            }
                            @foreach (var r in ratings)
                            {
                                                                                    <option value="@r.Value" selected="@(feedback.Rating == r.Value)">
                                                                                        @r.Label
                                                                                    </option>
                            }
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Your Review</label>
                        <textarea name="comment" class="form-control" rows="4" required>@feedback.Comment</textarea>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Review</button>
                </div>
            </form>
        </div>
    </div>
</div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="bi bi-info-circle me-2"></i>
                                            No reviews yet. Be the first to review this product!
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Quantity selector
        document.querySelector('.quantity-input').addEventListener('change', function() {
            document.querySelector('.quantity-value').value = this.value;
        });
        
        document.querySelector('.increase').addEventListener('click', function() {
            let input = document.querySelector('.quantity-input');
            let max = parseInt(input.getAttribute('max'));
            if (parseInt(input.value) < max) {
                input.value = parseInt(input.value) + 1;
                document.querySelector('.quantity-value').value = input.value;
            }
        });
        
        document.querySelector('.decrease').addEventListener('click', function() {
            let input = document.querySelector('.quantity-input');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
                document.querySelector('.quantity-value').value = input.value;
            }
        });

        // Thumbnail click
        document.querySelectorAll('.thumbnail-item').forEach(item => {
            item.addEventListener('click', function() {
                document.querySelectorAll('.thumbnail-item').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('main-product-image').src = this.dataset.image;
            });
        });

        // Star rating input
        document.querySelectorAll('.star-rating-input label').forEach(label => {
            label.addEventListener('mouseover', function() {
                let star = parseInt(this.getAttribute('for').replace('star', ''));
                document.querySelectorAll('.star-rating-input label').forEach((l, idx) => {
                    if (idx >= (5 - star)) {
                        l.classList.add('hover');
                    } else {
                        l.classList.remove('hover');
                    }
                });
            });
        });
    </script>
}
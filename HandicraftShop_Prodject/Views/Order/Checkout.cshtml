@model BussinessObject.Cart
@{
    ViewData["Title"] = "Checkout";
}

<section class="checkout-section container py-5">
    <h2 class="text-center mb-4">Checkout</h2>

    <form asp-action="CheckoutSubmit" asp-controller="Cart" method="post">
        <div class="row">
            <div class="col-md-7">
                <h5>Shipping Information</h5>
                <div class="mb-3">
                    <label for="shippingAddress" class="form-label">Shipping Address</label>
                    <input type="text" class="form-control" id="shippingAddress" name="shippingAddress" placeholder="Enter your full address" required />
                </div>

                <h5 class="mt-4">Payment Method</h5>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="COD" id="cod" checked>
                    <label class="form-check-label" for="cod">Cash on Delivery (COD)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="MoMo" id="momo">
                    <label class="form-check-label" for="momo">MoMo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="VNPay" id="vnpay">
                    <label class="form-check-label" for="vnpay">VNPay</label>
                </div>

                <button type="submit" class="btn btn-success btn-lg mt-4">Place Order</button>
            </div>

            <div class="col-md-5">
                <h5>Your Order Summary</h5>
                <div class="card shadow-sm">
                    <div class="card-body">
                        @foreach (var item in Model.CartItems)
                        {
                            var price = item.Product?.Price ?? 0M;
                            var qty = item.Quantity ?? 0;
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>@(item.Product?.ProductName ?? "Unknown") × @qty</span>
                                <span>@((price * qty).ToString("C0"))</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mt-3 fw-bold">
                            <span>Total:</span>
                            <span class="text-primary">
                                @(
                                    Model.CartItems.Sum(i => (i.Product?.Price ?? 0M) * (i.Quantity ?? 0))
                                    .ToString("C0")
                                    )
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@using DTO
@model IEnumerable<ProductDTO>
@{
    ViewData["Title"] = "Home Page";
}
<!-- Hero Section -->
<section class="ecommerce-hero-1 hero section" id="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 content-col" data-aos="fade-right" data-aos-delay="100">
                <div class="content">
                    <span class="promo-badge">New Handmade Collection 2025</span>
                    <h1>Discover Unique <span>Handmade Crafts</span> for Every Occasion</h1>
                    <p>HandicraftShop is an online platform dedicated to showcasing and selling handmade products. Explore a wide variety of unique crafts while supporting local artisans and promoting traditional craftsmanship.</p>
                    <div class="hero-cta">
                        <a href="/Product" class="btn btn-shop">Shop Now <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="hero-features">
                        <div class="feature-item">
                            <i class="bi bi-truck"></i>
                            <span>Free Shipping</span>
                        </div>
                        <div class="feature-item">
                            <i class="bi bi-shield-check"></i>
                            <span>Secure Payment</span>
                        </div>
                        <div class="feature-item">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>Easy Returns</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 image-col" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="~/assets/img/product/product-f-9.webp" alt="Handmade Product" class="main-product" loading="lazy">
                    <div class="floating-product product-1" data-aos="fade-up" data-aos-delay="300">
                        <img src="~/images/LB01/vo_dung_luc_binh_1.webp" alt="Product 2">
                        <div class="product-info">
                            <h4>Giỏ đựng đồ lục bình tròn</h4>
                            <span class="price">250000.00 VND</span>
                        </div>
                    </div>
                    <div class="floating-product product-2" data-aos="fade-up" data-aos-delay="400">
                        <img src="~/images/LB06/tui_xach_luc_binh_1.webp" alt="Product 3">
                        <div class="product-info">
                            <h4>Túi xách lục bình</h4>
                            <span class="price">350000.00 VND</span>
                        </div>
                    </div>
                    <div class="discount-badge" data-aos="zoom-in" data-aos-delay="500">
                        <span class="percent">30%</span>
                        <span class="text">OFF</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!-- /Hero Section -->
<!-- Info Cards Section -->
<section id="info-cards" class="info-cards section light-background">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                <div class="info-card text-center">
                    <div class="icon-box"><i class="bi bi-truck"></i></div>
                    <h3>Free Shipping</h3>
                    <p>Enjoy fast and free delivery for all handmade products worldwide.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                <div class="info-card text-center">
                    <div class="icon-box"><i class="bi bi-piggy-bank"></i></div>
                    <h3>Money Back Guarantee</h3>
                    <p>Full refund if you are not satisfied with the quality of your purchase.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="400">
                <div class="info-card text-center">
                    <div class="icon-box"><i class="bi bi-percent"></i></div>
                    <h3>Special Discounts</h3>
                    <p>Regular offers and discounts on selected handmade items.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="500">
                <div class="info-card text-center">
                    <div class="icon-box"><i class="bi bi-headset"></i></div>
                    <h3>24/7 Support</h3>
                    <p>Our team is always ready to help you with your orders and inquiries.</p>
                </div>
            </div>
        </div>
    </div>
</section><!-- /Info Cards Section -->
<!-- Best Sellers Section -->
<section id="best-sellers" class="best-sellers section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Featured Products</h2>
        <p>Explore our handpicked selection of unique crafts and artisan goods.</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="product-card">
                        <div class="product-image">
                            <img src="~/images/@item.ProductId/@item.ImageUrl" class="img-fluid default-image" alt="@item.ProductName" loading="lazy">
                            <img src="~/images/@item.ProductId/@item.ImageUrl" class="img-fluid hover-image" alt="@item.ProductName" loading="lazy">
                            @if (item.StockQuantity == 0)
                            {
                                <div class="product-tags">
                                    <span class="badge bg-sold-out">Sold Out</span>
                                </div>
                            }
                            else if (item.Discount > 0)
                            {
                                <div class="product-tags">
                                    <span class="badge bg-sale">Sale</span>
                                </div>
                            }
                            <div class="product-actions">
                                <a href="/Product/Detail/@item.ProductId"
                                   class="btn-quickview"
                                   aria-label="Xem chi tiết sản phẩm">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </div>
                        <div class="product-info">
                            <h3 class="product-title"><a href="/Product/Detail/@item.ProductId">@item.ProductName</a></h3>
                            <div class="product-price">
                                @{
                                    var originalPrice = item.Price ?? 0;
                                    var discountedPrice = originalPrice - (item.Discount ?? 0);
                                }
                                @if (originalPrice != discountedPrice)
                                {
                                    <span class="current-price">@discountedPrice.ToString("N0") VNĐ</span>
                                    <span class="original-price">@originalPrice.ToString("N0") VNĐ</span>
                                }
                                else
                                {
                                    <span class="current-price">@originalPrice.ToString("N0") VNĐ</span>
                                }
                            </div>
                            <div class="product-rating">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    if (item.AverageRating >= i)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else if (item.AverageRating >= i - 0.5)
                                    {
                                        <i class="bi bi-star-half text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-warning"></i>
                                    }
                                }
                                <span class="rating-count">(@item.AverageRating)</span>
                            </div>
                            @if (item.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" class="quantity-value" value="1" />
                                    <button type="submit" class="btn btn-primary add-to-cart-btn">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-add-to-cart btn-disabled" disabled=""><i class="bi bi-bag-plus me-2"></i>Sold Out</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section><!-- /Best Sellers Section -->

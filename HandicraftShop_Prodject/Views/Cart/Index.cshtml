@model BussinessObject.Cart
@{
    ViewData["Title"] = "Your Shopping Cart";
}

<section class="cart-section container py-5">
    <h2 class="text-center mb-4">Your Shopping Cart</h2>

    @if (Model == null || Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="text-center">
            <img src="~/images/empty-cart.png" alt="Empty cart" width="150" />
            <h5 class="mt-3">Your cart is empty</h5>
            <a href="/Product" class="btn btn-primary mt-3">Continue Shopping</a>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    var price = item.Product?.Price ?? 0;
                    var quantity = item.Quantity ?? 0;
                    var total = price * quantity;

                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="~/images/@item.ProductId/@item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl" width="60" class="me-3 rounded" />
                                <div>
                                    <strong>@item.Product?.ProductName</strong><br />
                                    <small>@item.Product?.Material</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <form asp-action="Edit" asp-controller="Cart" method="post" class="d-inline">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <input type="number" name="quantity" min="1" value="@quantity" class="form-control d-inline-block text-center" style="width:80px;" />
                                <button type="submit" class="btn btn-sm btn-outline-success ms-2">Update</button>
                            </form>
                        </td>
                        <td class="text-end">@price.ToString("N0") VND</td>
                        <td class="text-end">@total.ToString("N0") VND</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-controller="Cart" method="post">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-4">
            <h4>
                Total:
                <span class="text-primary fw-bold">
                    @(Model.CartItems.Sum(i => (i.Quantity ?? 0) * (i.Product?.Price ?? 0)).ToString("N0")) VND
                </span>
            </h4>
            <a asp-action="Checkout" asp-controller="Cart" class="btn btn-success btn-lg mt-3">
                Proceed to Checkout
            </a>
        </div>

    }
</section>

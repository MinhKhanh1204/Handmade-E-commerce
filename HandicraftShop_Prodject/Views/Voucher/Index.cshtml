@model List<DTO.VoucherDTO>
@{
    ViewData["Title"] = "Vouchers";
}
<!-- Page Title -->
<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">Vouchers</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="/Home">Home</a></li>
                <li class="current">Vouchers</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->

<!-- Voucher List Section -->
<section id="voucher-list" class="voucher-list section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        @if (Model != null && Model.Any())
        {
            <div class="row gy-4">
                @foreach (var voucher in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="voucher-card" style="border: 2px dashed #007bff; border-radius: 10px; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; position: relative; overflow: hidden;">
                            @if (!voucher.IsValid)
                            {
                                <div class="voucher-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1; display: flex; align-items: center; justify-content: center;">
                                    <span style="font-size: 24px; font-weight: bold;">EXPIRED</span>
                                </div>
                            }
                            <div style="position: relative; z-index: 2;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h3 class="mb-1" style="font-size: 24px; font-weight: bold;">@voucher.VoucherName</h3>
                                        <p class="mb-0" style="font-size: 14px; opacity: 0.9;">Code: <strong>@voucher.Code</strong></p>
                                    </div>
                                    <div class="text-end">
                                        <div style="font-size: 32px; font-weight: bold; line-height: 1;">
                                            @voucher.DiscountDisplay
                                        </div>
                                        <small style="font-size: 12px; opacity: 0.8;">OFF</small>
                                    </div>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(voucher.Description))
                                {
                                    <p style="font-size: 14px; margin-bottom: 15px; opacity: 0.9;">@voucher.Description</p>
                                }
                                
                                <div class="voucher-details" style="border-top: 1px solid rgba(255,255,255,0.3); padding-top: 15px; margin-top: 15px;">
                                    <div class="row g-2">
                                        @if (voucher.MinOrderValue.HasValue)
                                        {
                                            <div class="col-12">
                                                <small style="font-size: 12px; opacity: 0.8;">
                                                    <i class="bi bi-cart-check"></i> Min order: @voucher.MinOrderValue.Value.ToString("N0") VNĐ
                                                </small>
                                            </div>
                                        }
                                        @if (voucher.MaxReducing.HasValue)
                                        {
                                            <div class="col-12">
                                                <small style="font-size: 12px; opacity: 0.8;">
                                                    <i class="bi bi-tag"></i> Max reduce: @voucher.MaxReducing.Value.ToString("N0") VNĐ
                                                </small>
                                            </div>
                                        }
                                        @if (voucher.ExpiryDate.HasValue)
                                        {
                                            <div class="col-12">
                                                <small style="font-size: 12px; opacity: 0.8;">
                                                    <i class="bi bi-calendar-event"></i> Expires: @voucher.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                        }
                                        @if (voucher.RemainingQuantity.HasValue)
                                        {
                                            <div class="col-12">
                                                <small style="font-size: 12px; opacity: 0.8;">
                                                    <i class="bi bi-box"></i> Remaining: @voucher.RemainingQuantity
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <div class="mt-3">
                                    <a href="/Voucher/Detail/@voucher.VoucherId" class="btn btn-light btn-sm w-100" style="font-weight: bold;">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-ticket-perforated" style="font-size: 64px; color: #ccc;"></i>
                <h3 class="mt-3">No vouchers available</h3>
                <p class="text-muted">There are currently no active vouchers.</p>
            </div>
        }
    </div>
</section><!-- /Voucher List Section -->


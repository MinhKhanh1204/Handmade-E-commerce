@model DTO.ArticleDTO

@{
    ViewData["Title"] = "Article Details";
}

<div class="pagetitle">
    <h1>Article Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Articles" asp-action="Index">Article Management</a>
            </li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm p-4">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Article ID</label>
                        <input type="text" class="form-control" value="@Model.ArticleId" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Author</label>
                        <input type="text" class="form-control" value="@(Model.AuthorName ?? "-")" readonly />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" value="@Model.Title" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <input type="text" class="form-control" value="@(Model.Category ?? "-")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input type="text" class="form-control" value="@Model.Status" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Created At</label>
                        <input type="text" class="form-control" value="@(Model.CreatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Updated At</label>
                        <input type="text" class="form-control" value="@(Model.UpdatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Content</label>
                        <textarea class="form-control" rows="15" readonly>@Model.Content</textarea>
                    </div>

                    @if (Model.ArticleImages != null && Model.ArticleImages.Any())
                    {
                        <div class="col-12">
                            <label class="form-label">Article Images</label>
                            <div class="row g-3">
                                @foreach (var img in Model.ArticleImages)
                                {
                                    <div class="col-md-4">
                                        <div class="card">
                                            <div class="image-wrapper" style="height: 200px; width: 100%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; position: relative;">
                                                <img src="@img.ImageUrl" 
                                                     class="card-img-top article-image" 
                                                     alt="Article Image" 
                                                     loading="lazy"
                                                     decoding="async"
                                                     width="300"
                                                     height="200"
                                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0; transition: opacity 0.15s linear; will-change: opacity; backface-visibility: hidden; transform: translateZ(0); image-rendering: auto;"
                                                     onload="var img = this; requestAnimationFrame(function(){ img.style.opacity='1'; var placeholder = img.parentElement.querySelector('.image-placeholder'); if(placeholder) placeholder.style.display='none'; });"
                                                     onerror="var img = this; img.src='/images/no-image.png'; requestAnimationFrame(function(){ img.style.opacity='1'; var placeholder = img.parentElement.querySelector('.image-placeholder'); if(placeholder) placeholder.style.display='none'; });" />
                                                <div class="image-placeholder" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #999; font-size: 14px; z-index: 1; pointer-events: none;">Loading...</div>
                                            </div>
                                            <div class="card-body">
                                                @if (img.IsMain == true)
                                                {
                                                    <span class="badge bg-primary">Main Image</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-12 text-center mt-4">
                        <!-- Edit button -->
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.ArticleId" class="btn btn-primary me-2">
                            <i class="bi bi-pencil"></i> Edit
                        </a>

                        <!-- Delete button -->
                        <a asp-area="Admin" asp-action="Delete" asp-route-id="@Model.ArticleId" class="btn btn-danger me-2">
                            <i class="bi bi-trash"></i> Delete
                        </a>

                        <!-- Back button -->
                        <a asp-area="Admin" asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .article-image {
        will-change: opacity;
        backface-visibility: hidden;
        transform: translateZ(0);
        contain: layout style paint;
    }
    
    .image-wrapper {
        will-change: contents;
        contain: layout style;
        content-visibility: auto;
    }
    
    .image-wrapper img {
        image-rendering: auto;
    }
</style>

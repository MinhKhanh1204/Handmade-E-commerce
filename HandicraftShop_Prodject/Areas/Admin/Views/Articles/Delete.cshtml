@model DTO.ArticleDTO

@{
    ViewData["Title"] = "Delete Article";
}

<div class="pagetitle">
    <h1>Delete Article</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Articles" asp-action="Index">Article Management</a>
            </li>
            <li class="breadcrumb-item active">Delete</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm p-4">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Warning!</h4>
                    <p>Are you sure you want to delete this article? This action cannot be undone.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Article ID</label>
                        <input type="text" class="form-control" value="@Model.ArticleId" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Author</label>
                        <input type="text" class="form-control" value="@(Model.AuthorName ?? "-")" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" value="@Model.Title" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <input type="text" class="form-control" value="@(Model.Category ?? "-")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input type="text" class="form-control" value="@Model.Status" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Content Preview</label>
                        <textarea class="form-control" rows="5" readonly>@(Model.Content?.Length > 200 ? Model.Content.Substring(0, 200) + "..." : Model.Content)</textarea>
                    </div>

                    @if (Model.ArticleImages != null && Model.ArticleImages.Any())
                    {
                        <div class="col-12">
                            <label class="form-label">Article Images (@Model.ArticleImages.Count)</label>
                            <div class="row g-2">
                                @foreach (var img in Model.ArticleImages.Take(3))
                                {
                                    <div class="col-md-4">
                                        <div class="image-wrapper" style="height: 100px; width: 100%; overflow: hidden; background: #f0f0f0; position: relative;">
                                            <img src="@img.ImageUrl" 
                                                 class="img-thumbnail" 
                                                 alt="Article Image" 
                                                 loading="lazy"
                                                 decoding="async"
                                                 width="150"
                                                 height="100"
                                                 style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0; transition: opacity 0.2s ease-in-out; will-change: opacity; backface-visibility: hidden; transform: translateZ(0);"
                                                 onload="this.style.opacity='1'"
                                                 onerror="this.src='/images/no-image.png'; this.style.opacity='1'" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-12 text-center mt-4">
                        <form asp-area="Admin" asp-action="Delete" asp-route-id="@Model.ArticleId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger me-2" onclick="return confirm('Are you absolutely sure you want to delete this article?');">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


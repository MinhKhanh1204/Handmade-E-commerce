@model IEnumerable<DTO.ArticleDTO>
@using System.Linq

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Article Management";

    string currentSearch = "";
    if (ViewBag.SearchString != null)
    {
        currentSearch = ViewBag.SearchString.ToString();
    }
}

<div class="pagetitle">
    <h1>Article Management</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item active">Articles</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- Controls: Search, Add New -->
                    <div class="d-flex w-100 justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2">

                        <!-- Search -->
                        <div class="flex-grow-1">
                            <form method="get" class="d-flex">
                                <input type="text" name="searchString" value="@currentSearch"
                                       class="form-control me-2" placeholder="Search articles..." />
                                <button type="submit" class="btn btn-primary">Search</button>
                            </form>
                        </div>

                        <!-- Add New Article -->
                        <div>
                            <a asp-controller="Articles" asp-action="Create" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add New Article
                            </a>
                        </div>
                    </div>

                    <!-- Article Table -->
                    <table class="table table-striped table-hover align-middle mt-3">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Author</th>
                                <th>Status</th>
                                <th>Created At</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        No articles found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var article in Model)
                                {
                                    <tr>
                                        <td>@article.ArticleId</td>
                                        <td>
                                            <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @article.Title
                                            </div>
                                        </td>
                                        <td>@(article.Category ?? "-")</td>
                                        <td>@(article.AuthorName ?? "-")</td>
                                        <td>
                                            <span class="badge @(article.Status == "Published" ? "bg-success" : article.Status == "Draft" ? "bg-warning" : "bg-secondary")">
                                                @article.Status
                                            </span>
                                        </td>
                                        <td>@(article.CreatedAt?.ToString("yyyy/MM/dd") ?? "-")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Articles" asp-action="Details" asp-route-id="@article.ArticleId" class="btn btn-info text-white">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                                <a asp-controller="Articles" asp-action="Edit" asp-route-id="@article.ArticleId" class="btn btn-warning text-white">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <a asp-controller="Articles" asp-action="Delete" asp-route-id="@article.ArticleId" class="btn btn-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>

@model IEnumerable<BussinessObject.Article>

<table class="table datatable">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Title</td>
                <td>@a.AuthorId</td>
                <td>@a.Category</td>
                <td><span class="badge bg-warning">@a.Status</span></td>
                <td>
                    <form asp-action="Approve" method="post" class="d-inline">
                        <input type="hidden" name="type" value="article" />
                        <input type="hidden" name="id" value="@a.ArticleId" />
                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check"></i> Approve</button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline">
                        <input type="hidden" name="type" value="article" />
                        <input type="hidden" name="id" value="@a.ArticleId" />
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x"></i> Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

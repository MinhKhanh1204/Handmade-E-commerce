@model IEnumerable<BussinessObject.Category>

<table class="table datatable">
    <thead>
        <tr>
            <th>Category</th>
            <th>Description</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CategoryName</td>
                <td>@c.Description</td>
                <td><span class="badge bg-warning">@c.Status</span></td>
                <td>
                    <form asp-action="Approve" method="post" class="d-inline">
                        <input type="hidden" name="type" value="category" />
                        <input type="hidden" name="id" value="@c.CategoryId" />
                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check"></i> Approve</button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline">
                        <input type="hidden" name="type" value="category" />
                        <input type="hidden" name="id" value="@c.CategoryId" />
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x"></i> Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

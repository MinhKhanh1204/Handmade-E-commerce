@model DTO.StaffDTO

@{
    ViewData["Title"] = "Staff Details";
}

<div class="pagetitle">
    <h1>Staff Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Staffs" asp-action="Index">Staff Management</a>
            </li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm p-4">
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle" width="120" height="120" />
                    }
                    else
                    {
                        <img src="~/images/avatars/default.png" alt="Avatar" class="rounded-circle" width="120" height="120" />
                    }
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Staff ID</label>
                        <input type="text" class="form-control" value="@Model.StaffId" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" class="form-control" value="@Model.FullName" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Date of Birth</label>
                        <input type="text" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy/MM/dd") ?? "-")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Gender</label>
                        <input type="text" class="form-control" value="@(Model.Gender ?? "-")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Email</label>
                        <input type="text" class="form-control" value="@(Model.Email ?? "-")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Phone</label>
                        <input type="text" class="form-control" value="@(Model.Phone ?? "-")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Citizen ID</label>
                        <input type="text" class="form-control" value="@(Model.CitizenId ?? "-")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Hire Date</label>
                        <input type="text" class="form-control" value="@(Model.HireDate?.ToString("yyyy/MM/dd") ?? "-")" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Address</label>
                        <textarea class="form-control" rows="2" readonly>@(Model.Address ?? "-")</textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Status</label>
                        <input type="text" class="form-control" value="@Model.Status" readonly />
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.StaffId" class="btn btn-primary me-2">
                        <i class="bi bi-pencil"></i> Edit
                    </a>

                    <form asp-area="Admin" asp-action="Delete" asp-route-id="@Model.StaffId" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this staff?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>

                    <a asp-area="Admin" asp-action="Index" class="btn btn-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
